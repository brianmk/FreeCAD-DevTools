      "script": "vk_geomlod_probe.py",
      "env": {
        "FC_VULKAN_BACKEND_DEBUG": "1",
        "FC_VULKAN_GEOM_LOD_ALWAYS": "1",
        "COIN_VULKAN_BACKEND_DEBUG": "1",
        "COIN_VULKAN_GEOM_LOD_ALWAYS": "1"
      },
      "timeout": 300
    },
    {
