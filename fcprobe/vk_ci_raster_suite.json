      "script": "vk_interaction_probe.py",
      "env": {
        "FC_VULKAN_BACKEND_DEBUG": "1",
        "COIN_VULKAN_BACKEND_DEBUG": "1"
      },
      "timeout": 300
    },
    {
      "name": "grid-lod",
      "script": "vk_grid_lod_probe.py",
